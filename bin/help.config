#!/usr/bin/env bash

cat <<EOT
Environment variables:
  ASDF_JETBRAINS_SKIP_CHECKSUM  Any non-empty value skips SHA-256 verification.
  ASDF_JETBRAINS_CACHE_TTL      Seconds to keep release lists in
                                \${XDG_CACHE_HOME:-~/.cache}/asdf-jetbrains, 3600 by default, 0 disables.
EOT
