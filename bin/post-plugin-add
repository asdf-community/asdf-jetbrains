#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=lib/utils.bash
source "${plugin_dir}/lib/utils.bash"

# Sourcing utils.bash fails for an unknown or discontinued product name.
echo "JetBrains product: $TOOL_NAME ($JETBRAINS_PRODUCT_CODE)"
