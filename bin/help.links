#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=lib/utils.bash
source "${plugin_dir}/lib/utils.bash"

case "$TOOL_NAME" in
gateway) page=remote-development/gateway ;;
goland) page=go ;;
ideac) page=idea ;;
pycharmc) page=pycharm ;;
rubymine) page=ruby ;;
rustrover) page=rust ;;
toolbox) page=toolbox-app ;;
*) page="$TOOL_NAME" ;;
esac

cat <<EOT
Product: https://www.jetbrains.com/$page/
Releases: https://data.services.jetbrains.com/products/releases?code=$JETBRAINS_PRODUCT_CODE&type=release
Plugin: https://github.com/asdf-community/asdf-jetbrains
EOT
