#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=lib/utils.bash
source "${plugin_dir}/lib/utils.bash"

cat <<EOT
JetBrains IDEs and Toolbox App, the plugin name defines the product: "asdf plugin add idea <url>"
puts the "idea" command on PATH. Supported names:

$(supported_products)
EOT
